// Start of LinkedIn sign-in. Issues a state bound to the browser's nonce and returns the LinkedIn URL to
// navigate to. POST keeps the nonce in the request body, out of URLs and access logs.
query "oauth/linkedin/init" verb=POST {
  api_group = "linkedin-oauth"

  input {
    // 64 lowercase hex characters, generated by the browser and kept in sessionStorage
    text nonce filters=trim
  }

  stack {
    function.run oauth_state_issue {
      input = {provider: "linkedin", nonce: $input.nonce}
    } as $oauth_state

    function.run linkedin_oauth_getauthurl {
      input = {state: $oauth_state}
    } as $auth_url
  }

  response = {authUrl: $auth_url}
}
