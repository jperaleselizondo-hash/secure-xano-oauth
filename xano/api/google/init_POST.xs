// Start of Google sign-in. Issues a state bound to the browser's nonce and returns the Google URL to
// navigate to. POST keeps the nonce in the request body, out of URLs and access logs.
query "oauth/google/init" verb=POST {
  api_group = "google-oauth"

  input {
    // 64 lowercase hex characters, generated by the browser and kept in sessionStorage
    text nonce filters=trim
  }

  stack {
    function.run oauth_state_issue {
      input = {provider: "google", nonce: $input.nonce}
    } as $oauth_state

    function.run google_oauth_getauthurl {
      input = {state: $oauth_state}
    } as $auth_url
  }

  response = {authUrl: $auth_url}
}
