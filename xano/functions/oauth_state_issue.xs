// Issues a signed OAuth state that binds a sign-in to the browser that started it.
//
// The browser generates a 256-bit nonce (64 lowercase hex characters), keeps it in sessionStorage and
// sends it to the init endpoint. The state carries only the nonce's SHA-256 hash, the provider and a
// 10-minute expiry, signed with HMAC-SHA256 using $env.OAUTH_STATE_SECRET. The raw nonce never enters a URL.
//
// Format: <base64url(JSON payload)>~<hex HMAC-SHA256 of the payload>
// "~" cannot occur in either part. Do not switch to ".": Xano's base64_encode_urlsafe pads with ".",
// so a "." separator breaks for payload lengths that need padding.
function oauth_state_issue {
  input {
    // Provider this state is issued for. Extend the allowlist below to add providers.
    text provider filters=trim

    // 64 lowercase hex characters generated by the browser
    text nonce filters=trim
  }

  stack {
    precondition ($env.OAUTH_STATE_SECRET != null && ($env.OAUTH_STATE_SECRET|strlen) >= 64) {
      error = "OAuth state signing is not configured."
    }

    precondition (($input.provider == "google" || $input.provider == "linkedin") && ("/^[0-9a-f]{64}$/"|regex_matches:$input.nonce)) {
      error_type = "inputerror"
      error = "Invalid sign-in request. Please try again."
    }

    var $state_payload {
      value = {
        p  : $input.provider
        exp: now|add_secs_to_timestamp:600
        bh : $input.nonce|sha256
      }|json_encode|base64_encode_urlsafe
    }

    var $state_signature {
      value = $state_payload
        |hmac_sha256:$env.OAUTH_STATE_SECRET
    }
  }

  response = $state_payload ~ "~" ~ $state_signature
}
